# Layer 2 — ROS 2 Humble + colcon + rosdep on top of fastbot-ubuntu-base.
FROM fastbot-ubuntu-base:latest

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=humble

LABEL description="FastBot ROS2 Humble base — minimal ROS layer"

# Install ROS 2 Humble (ros-base) + build toolchain needed for runs colcon build
RUN apt-get update && apt-get install -y --no-install-recommends \
    # ROS 2 core (no rviz, no gazebo, no desktop extras)
    ros-${ROS_DISTRO}-ros-base \
    # CycloneDDS — more reliable than FastDDS in Docker/host-network setups
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    # Build tools (needed in every child image that clones + builds a package)
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-argcomplete \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Initialise rosdep (must be done here, not in child images)
RUN rosdep init && rosdep update

# Environment variables — inherited by subsequent image
ENV ROS_DISTRO=${ROS_DISTRO}
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=0

# Source ROS for interactive shells
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash" >> /root/.bashrc

# Shared entrypoint — sources ROS and workspace overlay before any CMD
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /ros2_ws

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]