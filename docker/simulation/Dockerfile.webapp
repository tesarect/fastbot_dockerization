# =============================================================================
# Dockerfile.web  —  fastbot-ros2-webapp
# Build context: project root (fastbot_ros2_docker/)
#
# Serves the FastBot web control panel:
#   - ROSBridge WebSocket  (port 9090)  — browser ↔ ROS topics
#   - Web Video Server     (port 11315) — camera stream MJPEG
#   - TF2 Web Republisher             — TF transforms for roslibjs
#   - HTTP Server          (port 8000)  — serves web UI files
#
# fastbot_webapp integration:
#   Once webapp package is ready, uncomment the COPY line below and rebuild.
#   The package can also be added by cloning directly:
#     RUN git clone https://github.com/<user>/fastbot_webapp /ros2_ws/src/fastbot_webapp
#
# Build:
#   docker build -f simulation/Dockerfile.web -t <repo>:fastbot-ros2-webapp .
# Test:
#   docker run --rm -it --network host <repo>:fastbot-ros2-webapp bash
#   # verify: ros2 pkg list | grep rosbridge | nginx -v
# =============================================================================
FROM ros:humble-ros-base

ARG DEBIAN_FRONTEND=noninteractive

LABEL description="FastBot ROS2 Web Application Image"

# ros-base is enough here — no GUI needed in webapp container
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rosbridge-server \
    ros-humble-web-video-server \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-xacro \
    python3-colcon-common-extensions \
    python3-pip \
    python3-numpy \
    curl \
    && rm -rf /var/lib/apt/lists/*

# pyquaternion needed by tf2_web_republisher
RUN pip3 install pyquaternion

RUN rosdep update

# Environment
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=0

# Copy packages from project root into image
RUN mkdir -p /ros2_ws/src
COPY tf2_web_republisher_py /ros2_ws/src/tf2_web_republisher_py

# ── fastbot_webapp integration ───────────────────────────────────────────────
# Option A: Copy local folder (uncomment once webapp is ready)
# COPY fastbot_webapp /ros2_ws/src/fastbot_webapp
#
# Option B: Clone from git (uncomment and set correct repo URL)
# RUN git clone https://github.com/<your_username>/fastbot_webapp.git \
#         /ros2_ws/src/fastbot_webapp
# ─────────────────────────────────────────────────────────────────────────────

# Build workspace at image build time
WORKDIR /ros2_ws
RUN /bin/bash -c "source /opt/ros/humble/setup.bash \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install"

# Source workspace for interactive shells
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc \
    && echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

COPY simulation/scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY simulation/scripts/start_web_services.sh /ros2_ws/start_web_services.sh
RUN chmod +x /ros2_ws/start_web_services.sh

EXPOSE 9090 11315 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/ros2_ws/start_web_services.sh"]