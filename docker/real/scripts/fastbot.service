# =============================================================================
# fastbot.service — systemd service for auto-starting FastBot on boot
#
# Install:
#   sudo cp fastbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable fastbot.service
#   sudo systemctl start fastbot.service
#
# Check status:
#   sudo systemctl status fastbot.service
#   sudo journalctl -u fastbot.service -f
# =============================================================================

[Unit]
Description=FastBot ROS2 Real Robot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="DOCKERHUB_USER=tesarect"
RemainAfterExit=yes
WorkingDirectory=/home/fastbot/ros2_ws/src/docker/real
ExecStart=/usr/bin/docker-compose -f docker-compose.yaml up robot
ExecStop=/usr/bin/docker-compose stop
TimeoutStartSec=120
User=fastbot
Group=docker
Restart=always

[Install]
# start when the system reaches the normal multi-user boot state
WantedBy=multi-user.target
