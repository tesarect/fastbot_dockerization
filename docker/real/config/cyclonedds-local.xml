<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS — Local/Standalone (no VPN)
  Use when running robot on Pi without remote access.
  Auto-discovers peers on local network via multicast.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>100</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
